    "decisions": [
      {
        "question": "Which retention period applies to exported logs?",
        "why_blocking": "The specification cannot fix the schema without it.",
        "options": [
          {
            "label": "30 days",
            "tradeoffs": "Cheaper storage, shorter audit window."
          },
          {
            "label": "1 year",
            "tradeoffs": "Longer audit window, higher storage cost."
          }
        ],
        "recommendation": "30 days"
      },
      {
        "question": "Where are exported logs stored?",
        "why_blocking": "The export target decides the storage schema.",
        "options": [
          {
            "label": "Object storage",
            "tradeoffs": "Cheap, slower to query."
          },
          {
            "label": "Warehouse",
            "tradeoffs": "Fast to query, costlier."
          }
        ],
        "recommendation": "Object storage"
      }
    ],
    "previous_answers": [
