{
  "spec": {
    "name": "freeside-review-review-1-codex",
    "image": "example.test/codex@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "command": [
      "sh",
      "-c",
      "set -e; mkdir -p '/var/lib/freeside/codex-home'; ln -s '/var/lib/freeside/codex-snapshot/auth.json' '/var/lib/freeside/codex-home/auth.json'; ln -s '/var/lib/freeside/codex-snapshot/AGENTS.md' '/var/lib/freeside/codex-home/AGENTS.md'; mkdir -p '/freeside-review-output'; printf '%s' '{\"type\":\"object\",\"properties\":{\"findings\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"severity\":{\"type\":\"string\",\"enum\":[\"P1\",\"P2\",\"P3\"]},\"location\":{\"type\":\"string\"},\"explanation\":{\"type\":\"string\"}},\"required\":[\"severity\",\"location\",\"explanation\"],\"additionalProperties\":false}}},\"required\":[\"findings\"],\"additionalProperties\":false}' \u003e '/freeside-review-output/schema.json'; set +e; codex exec --json --ephemeral --skip-git-repo-check -s read-only -C '/workspace/project' -m 'gpt-5.2-codex' -c 'model_reasoning_effort=\"high\"' -c project_doc_max_bytes=0 --ignore-user-config --ignore-rules --output-schema '/freeside-review-output/schema.json' --output-last-message '/freeside-review-output/result.json' -- 'Review the exact candidate head.' \u003e '/freeside-review-output/events.jsonl' 2\u003e\u00261; review_status=$?; printf '%s\\n' \"$review_status\" \u003e '/freeside-review-output/status'; exit \"$review_status\""
    ],
    "env": [
      "HOME=/var/lib/freeside/home",
      "CODEX_HOME=/var/lib/freeside/codex-home",
      "HTTP_PROXY=http://127.0.0.1:43123",
      "HTTPS_PROXY=http://127.0.0.1:43123",
      "http_proxy=http://127.0.0.1:43123",
      "https_proxy=http://127.0.0.1:43123",
      "NO_PROXY=",
      "no_proxy="
    ],
    "mounts": [
      {
        "type": "volume",
        "source": "freeside-handoff-review-1-ws",
        "target": "/workspace/project",
        "read_only": true
      },
      {
        "type": "volume",
        "source": "freeside-review-review-1-snap",
        "target": "/var/lib/freeside/codex-snapshot",
        "read_only": true
      },
      {
        "type": "volume",
        "source": "freeside-review-review-1-agents",
        "target": "/.agents",
        "read_only": true
      },
      {
        "type": "volume",
        "source": "freeside-review-review-1-agents",
        "target": "/var/lib/freeside/home/.agents",
        "read_only": true
      },
      {
