    "-c",
    "set -e; mkdir -p '/var/lib/freeside/home' '/var/lib/freeside/codex-home' '/var/lib/freeside/lineup-probe/out'; cd '/var/lib/freeside/home'; n=0; while [ ! -f '/lineup-probe-ready/ready' ]; do n=$((n+1)); [ \"$n\" -le 60 ] || exit 1; sleep 1; done; cp '/lineup-probe-stage/credential' '/var/lib/freeside/codex-home/auth.json'; chmod 0600 '/var/lib/freeside/codex-home/auth.json'; rm -rf '/lineup-probe-stage'; set +e; codex --version > '/var/lib/freeside/lineup-probe/out/version' 2>&1; trap '' PIPE; rm -f '/var/lib/freeside/lineup-probe/input'; mkfifo '/var/lib/freeside/lineup-probe/input'; codex app-server --listen stdio:// < '/var/lib/freeside/lineup-probe/input' > '/var/lib/freeside/lineup-probe/out/stdout' 2> '/var/lib/freeside/lineup-probe/out/stderr' & pid=$!; exec 3> '/var/lib/freeside/lineup-probe/input'; t=0; answered() { jq -en --argjson id \"$1\" 'first(inputs | select(type == \"object\" and (has(\"method\") | not) and .id == $id))' < '/var/lib/freeside/lineup-probe/out/stdout' > /dev/null 2>&1; }; await() { until answered \"$1\"; do kill -0 \"$pid\" 2> /dev/null || { answered \"$1\"; return; }; t=$((t+1)); [ \"$t\" -le 120 ] || return 1; sleep 1; done; }; printf '%s\\n' '{\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"freeside-model-discovery\",\"version\":\"1\"}}}' >&3; if await 1; then printf '%s\\n' '{\"method\":\"initialized\"}' >&3; id=2; cursor=; while [ \"$id\" -le 9 ]; do jq -nc --argjson id \"$id\" --arg cursor \"$cursor\" '{id: $id, method: \"model/list\", params: ({limit: 100} + (if $cursor == \"\" then {} else {cursor: $cursor} end))}' >&3; await \"$id\" || break; cursor=\"$(jq -rn --argjson id \"$id\" 'first(inputs | select(type == \"object\" and (has(\"method\") | not) and .id == $id)) | .result.nextCursor // empty' < '/var/lib/freeside/lineup-probe/out/stdout')\"; [ -n \"$cursor\" ] || break; id=$((id+1)); done; fi; exec 3>&-; t=0; while kill -0 \"$pid\" 2> /dev/null && [ \"$t\" -lt 10 ]; do t=$((t+1)); sleep 1; done; kill \"$pid\" 2> /dev/null; wait \"$pid\"; status=$?; rm -f '/var/lib/freeside/lineup-probe/input'; rm -rf '/var/lib/freeside/codex-home'; printf '%s\\n' \"$status\" > '/var/lib/freeside/lineup-probe/out/status'; sync; exit 0",
