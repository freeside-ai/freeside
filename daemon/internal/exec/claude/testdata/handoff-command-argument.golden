[
  "sh",
  "-c",
  "set -eu; chmod 0711 /root; rm -rf '/workspace/.freeside-evidence'; find '/workspace' -mindepth 1 -maxdepth 1 -exec chown -hR 1001:1001 {} +; chown 0:0 '/workspace'; chmod 1777 '/workspace'; mkdir -p '/workspace/.freeside-evidence'; chown 0:0 '/workspace/.freeside-evidence'; chmod 1777 '/workspace/.freeside-evidence'; mkdir -p '/workspace/.freeside-evidence/.control'; chown 0:0 '/workspace/.freeside-evidence/.control'; chmod 0700 '/workspace/.freeside-evidence/.control'; printf '%s\\n' '{\"version\":\"freeside.export.evidence-source/v1\",\"sources\":[{\"label\":\"agent-transcript\",\"media_type\":\"application/jsonl\",\"path\":\".freeside-evidence/agent-transcript.jsonl\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"sensitive\",\"producer_invocation_id\":\"inv-provider-spec\"}]}' \u003e '/workspace/.freeside-evidence/evidence.json'; chown 0:0 '/workspace/.freeside-evidence/evidence.json'; chmod 0644 '/workspace/.freeside-evidence/evidence.json'; chown 1001:1001 '/var/lib/freeside/claude-config/projects' '/var/lib/freeside/claude-config/session-env'; chmod 0700 '/var/lib/freeside/claude-config/projects' '/var/lib/freeside/claude-config/session-env'; cd '/workspace'; status=86; if [ -s '/var/lib/freeside/claude-token/token' ] \u0026\u0026 token=$(cat '/var/lib/freeside/claude-token/token'); then set +e; HOME=/root CLAUDE_CONFIG_DIR='/var/lib/freeside/claude-config' DISABLE_AUTOUPDATER=1 DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 IS_SANDBOX=1 CLAUDE_CODE_OAUTH_TOKEN=\"$token\" setpriv --reuid=1001 --regid=1001 --clear-groups --inh-caps=-all --ambient-caps=-all --bounding-set=-all --no-new-privs claude -p 'do the work' --output-format stream-json --verbose --dangerously-skip-permissions --safe-mode --session-id '57ca15d9-fb4c-4925-ba92-e1c9460c3fa3' --append-system-prompt-file '/root/.claude/CLAUDE.md' \u003e '/workspace/.freeside-evidence/agent-transcript.jsonl' 2\u003e\u00261; status=$?; set -e; unset token; fi; sources='{\"label\":\"agent-transcript\",\"media_type\":\"application/jsonl\",\"path\":\".freeside-evidence/agent-transcript.jsonl\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"sensitive\",\"producer_invocation_id\":\"inv-provider-spec\"}'; declare=0; if [ -f '.freeside-evidence/publication.md' ] \u0026\u0026 [ ! -L '.freeside-evidence/publication.md' ]; then sources=\"$sources\",'{\"label\":\"freeside.publication\",\"media_type\":\"text/markdown\",\"path\":\".freeside-evidence/publication.md\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"normal\",\"producer_invocation_id\":\"inv-provider-spec\"}'; declare=1; fi; if [ -f '.freeside-evidence/summary.md' ] \u0026\u0026 [ ! -L '.freeside-evidence/summary.md' ]; then sources=\"$sources\",'{\"label\":\"freeside.summary\",\"media_type\":\"text/markdown\",\"path\":\".freeside-evidence/summary.md\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"sensitive\",\"producer_invocation_id\":\"inv-provider-spec\"}'; declare=1; fi; if [ -f '.freeside-evidence/blocked.json' ] \u0026\u0026 [ ! -L '.freeside-evidence/blocked.json' ]; then sources=\"$sources\",'{\"label\":\"freeside.blocked\",\"media_type\":\"application/json\",\"path\":\".freeside-evidence/blocked.json\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"normal\",\"producer_invocation_id\":\"inv-provider-spec\"}'; declare=1; fi; if [ -f '.freeside-evidence/scope-conflict.json' ] \u0026\u0026 [ ! -L '.freeside-evidence/scope-conflict.json' ]; then sources=\"$sources\",'{\"label\":\"freeside.scope-conflict\",\"media_type\":\"application/json\",\"path\":\".freeside-evidence/scope-conflict.json\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"normal\",\"producer_invocation_id\":\"inv-provider-spec\"}'; declare=1; fi; if [ \"$declare\" = 1 ]; then printf '%s\\n' '{\"version\":\"freeside.export.evidence-source/v1\",\"sources\":['\"$sources\"']}' \u003e '/workspace/.freeside-evidence/evidence.json'; fi; rm -rf -- '/workspace/node_modules'; printf '%s %s\\n' '{{FREESIDE_WRITER_NONCE}}' \"$status\" \u003e '/workspace/.freeside-evidence/.control/writer-outcome'; sync; exit \"$status\""
]
