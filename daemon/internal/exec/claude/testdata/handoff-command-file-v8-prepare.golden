[
  "sh",
  "-c",
  "set -eu; chmod 0711 /root; rm -rf '/workspace/.freeside-evidence'; if [ -d '/workspace/.git' ] \u0026\u0026 [ ! -L '/workspace/.git' ]; then mkdir -p '/workspace/.git/info'; printf '\\n%s\\n%s\\n' '/.freeside-evidence/' '/.freeside-commit-plan.json' \u003e\u003e '/workspace/.git/info/exclude'; fi; prepare_status=0; set +e; ( cd '/workspace' \u0026\u0026 HOME='/tmp/freeside-home' LC_ALL=C '/usr/local/bin/freeside-project-prepare' ); prepare_status=$?; set -e; find '/workspace' -mindepth 1 -maxdepth 1 -exec chown -hR 1001:1001 {} +; chown 0:0 '/workspace'; chmod 1777 '/workspace'; mkdir -p '/workspace/.freeside-evidence'; chown 0:0 '/workspace/.freeside-evidence'; chmod 1777 '/workspace/.freeside-evidence'; mkdir -p '/workspace/.freeside-evidence/.control'; chown 0:0 '/workspace/.freeside-evidence/.control'; chmod 0755 '/workspace/.freeside-evidence/.control'; rm -rf '/var/lib/freeside-launch'; mkdir '/var/lib/freeside-launch'; chown 0:0 '/var/lib/freeside-launch'; chmod 0700 '/var/lib/freeside-launch'; rm -rf '/var/lib/freeside-driver'; mkdir '/var/lib/freeside-driver'; chown 0:0 '/var/lib/freeside-driver'; chmod 0755 '/var/lib/freeside-driver'; printf '%s' '// The file_v6 writer'\\''s usage driver. It runs under the same privilege drop\n// as the CLI and holds nothing the CLI does not: it reads the prompt from\n// stdin, runs the argv it was given, and copies the CLI'\\''s stdout to its own\n// unchanged, so the transcript is still the CLI'\\''s alone.\n//\n// It drives one turn over the CLI'\\''s stream-json input: initialize, the\n// prompt as one user message, and after the turn'\\''s result exactly one\n// get_usage request, which the CLI answers from that turn'\\''s rate-limit\n// headers. It then closes the CLI'\\''s stdin so the CLI exits. Nothing here\n// infers, reads a file, or prints the environment. Usage is optional: an\n// unanswered get_usage closes stdin after ANSWER_TIMEOUT_MS, and the exit\n// status is always the CLI'\\''s. A CLI that never answers initialize gets EOF\n// after INIT_TIMEOUT_MS, as a file_v5 CLI would see it at once. Once the CLI\n// exits, the driver waits at most EXIT_GRACE_MS for its stdout to drain, so\n// a descendant still holding that pipe cannot keep the stage running. The\n// prompt is the renderer'\\''s complete UTF-8, so decoding it keeps every byte.\n// The request ids are the ones the daemon'\\''s transcript reader matches\n// (exec.ClaudeUsageRequestID).\n'\\''use strict'\\'';\nconst {spawn} = require('\\''node:child_process'\\'');\nconst {constants} = require('\\''node:os'\\'');\nconst {StringDecoder} = require('\\''node:string_decoder'\\'');\n\nconst INIT_ID = '\\''usage-init'\\'';\nconst USAGE_ID = '\\''usage-read'\\'';\nconst ANSWER_TIMEOUT_MS = 15000;\nconst INIT_TIMEOUT_MS = 120000;\nconst EXIT_GRACE_MS = 2000;\n\nfunction readStdin() {\n  return new Promise((resolve, reject) =\u003e {\n    const chunks = [];\n    process.stdin.on('\\''data'\\'', chunk =\u003e chunks.push(chunk));\n    process.stdin.on('\\''end'\\'', () =\u003e resolve(Buffer.concat(chunks).toString('\\''utf8'\\'')));\n    process.stdin.on('\\''error'\\'', reject);\n  });\n}\n\nasync function main() {\n  const [command, ...args] = process.argv.slice(2);\n  const prompt = await readStdin();\n  const child = spawn(command, args, {stdio: ['\\''pipe'\\'', '\\''pipe'\\'', '\\''inherit'\\'']});\n  for (const signal of ['\\''SIGHUP'\\'', '\\''SIGINT'\\'', '\\''SIGTERM'\\'']) process.on(signal, () =\u003e child.kill(signal));\n  // A CLI that exits early closes its stdin; a late write must not crash\n  // the driver before it reports the CLI'\\''s status.\n  child.stdin.on('\\''error'\\'', () =\u003e {});\n  const send = message =\u003e child.stdin.write(JSON.stringify(message) + '\\''\\n'\\'');\n  let prompted = false, resulted = false, closed = false, timer;\n  const close = () =\u003e {\n    if (closed) return;\n    closed = true;\n    clearTimeout(timer);\n    child.stdin.end();\n  };\n  timer = setTimeout(close, INIT_TIMEOUT_MS);\n  const handle = line =\u003e {\n    let message;\n    try { message = JSON.parse(line); } catch { return; }\n    if (message === null || typeof message !== '\\''object'\\'') return;\n    const id = message.type === '\\''control_response'\\'' ? message.response?.request_id : undefined;\n    if (id === INIT_ID \u0026\u0026 !prompted \u0026\u0026 !closed) {\n      prompted = true;\n      clearTimeout(timer);\n      send({type: '\\''user'\\'', message: {role: '\\''user'\\'', content: prompt}});\n    } else if (message.type === '\\''result'\\'' \u0026\u0026 prompted \u0026\u0026 !resulted) {\n      resulted = true;\n      send({type: '\\''control_request'\\'', request_id: USAGE_ID, request: {subtype: '\\''get_usage'\\''}});\n      timer = setTimeout(close, ANSWER_TIMEOUT_MS);\n    } else if (id === USAGE_ID \u0026\u0026 resulted) {\n      close();\n    }\n  };\n  // The bytes pass through untouched; only this decoded copy is parsed, and\n  // the decoder keeps a character split across chunks whole.\n  const decoder = new StringDecoder('\\''utf8'\\'');\n  let pending = '\\'''\\'';\n  child.stdout.on('\\''data'\\'', chunk =\u003e {\n    process.stdout.write(chunk);\n    pending += decoder.write(chunk);\n    for (let end; (end = pending.indexOf('\\''\\n'\\'')) \u003e= 0;) {\n      const line = pending.slice(0, end);\n      pending = pending.slice(end + 1);\n      handle(line);\n    }\n  });\n  send({type: '\\''control_request'\\'', request_id: INIT_ID, request: {subtype: '\\''initialize'\\''}});\n  const [code, signal] = await new Promise(resolve =\u003e {\n    child.on('\\''error'\\'', () =\u003e resolve([127, null]));\n    child.on('\\''exit'\\'', (code, signal) =\u003e {\n      let grace;\n      const done = () =\u003e { clearTimeout(grace); resolve([code, signal]); };\n      if (child.stdout.closed) return done();\n      child.stdout.on('\\''close'\\'', done);\n      grace = setTimeout(() =\u003e { child.stdout.destroy(); done(); }, EXIT_GRACE_MS);\n    });\n  });\n  clearTimeout(timer);\n  process.exitCode = signal ? 128 + (constants.signals[signal] ?? 0) : code;\n}\n\nmain().catch(() =\u003e { process.exitCode = 1; });\n' \u003e '/var/lib/freeside-driver/usage-driver.cjs'; chown 0:0 '/var/lib/freeside-driver/usage-driver.cjs'; chmod 0444 '/var/lib/freeside-driver/usage-driver.cjs'; chown 1001:1001 '/var/lib/freeside/claude-config/projects' '/var/lib/freeside/claude-config/session-env'; chmod 0700 '/var/lib/freeside/claude-config/projects' '/var/lib/freeside/claude-config/session-env'; cd '/workspace'; status=86; if [ \"$prepare_status\" -ne 0 ]; then status=87; elif [ -s '/var/lib/freeside/claude-token/token' ] \u0026\u0026 token=$(cat '/var/lib/freeside/claude-token/token'); then set +e; HOME=/root CLAUDE_CONFIG_DIR='/var/lib/freeside/claude-config' DISABLE_AUTOUPDATER=1 DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 IS_SANDBOX=1 CLAUDE_CODE_OAUTH_TOKEN=\"$token\" CLAUDE_CODE_OAUTH_SCOPES='user:inference user:profile' setpriv --reuid=1001 --regid=1001 --clear-groups --inh-caps=-all --ambient-caps=-all --bounding-set=-all --no-new-privs node '/var/lib/freeside-driver/usage-driver.cjs' claude -p \u003c '/var/lib/freeside/prompt/prompt.txt' --output-format stream-json --verbose --dangerously-skip-permissions --safe-mode --session-id '57ca15d9-fb4c-4925-ba92-e1c9460c3fa3' --append-system-prompt-file '/root/.claude/CLAUDE.md' --settings '{\"attribution\":{\"commit\":\"\",\"pr\":\"\"},\"enabledPlugins\":{\"agents-md@builtin\":false}}' --input-format stream-json \u003e '/var/lib/freeside-launch/agent-transcript.jsonl' 2\u003e '/var/lib/freeside-launch/agent-stderr.log'; status=$?; set -e; unset token; fi; chmod 0755 '/workspace/.freeside-evidence'; chmod 0700 '/workspace/.freeside-evidence/.control'; sources='{\"label\":\"agent-transcript\",\"media_type\":\"application/jsonl\",\"path\":\".freeside-evidence/agent-transcript.jsonl\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"sensitive\",\"producer_invocation_id\":\"inv-provider-spec\"}'; if [ -f '.freeside-evidence/publication.md' ] \u0026\u0026 [ ! -L '.freeside-evidence/publication.md' ]; then sources=\"$sources\",'{\"label\":\"freeside.publication\",\"media_type\":\"text/markdown\",\"path\":\".freeside-evidence/publication.md\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"normal\",\"producer_invocation_id\":\"inv-provider-spec\"}'; fi; if [ -f '.freeside-evidence/summary.md' ] \u0026\u0026 [ ! -L '.freeside-evidence/summary.md' ]; then sources=\"$sources\",'{\"label\":\"freeside.summary\",\"media_type\":\"text/markdown\",\"path\":\".freeside-evidence/summary.md\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"sensitive\",\"producer_invocation_id\":\"inv-provider-spec\"}'; fi; if [ -f '.freeside-evidence/blocked.json' ] \u0026\u0026 [ ! -L '.freeside-evidence/blocked.json' ]; then sources=\"$sources\",'{\"label\":\"freeside.blocked\",\"media_type\":\"application/json\",\"path\":\".freeside-evidence/blocked.json\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"normal\",\"producer_invocation_id\":\"inv-provider-spec\"}'; fi; if [ -f '.freeside-evidence/scope-conflict.json' ] \u0026\u0026 [ ! -L '.freeside-evidence/scope-conflict.json' ]; then sources=\"$sources\",'{\"label\":\"freeside.scope-conflict\",\"media_type\":\"application/json\",\"path\":\".freeside-evidence/scope-conflict.json\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"normal\",\"producer_invocation_id\":\"inv-provider-spec\"}'; fi; if [ -f '.freeside-evidence/review-guide.json' ] \u0026\u0026 [ ! -L '.freeside-evidence/review-guide.json' ]; then sources=\"$sources\",'{\"label\":\"freeside.review-guide\",\"media_type\":\"application/json\",\"path\":\".freeside-evidence/review-guide.json\",\"head_binding\":\"head_independent\",\"sensitivity_class\":\"sensitive\",\"producer_invocation_id\":\"inv-provider-spec\"}'; fi; printf '%s\\n' '{\"version\":\"freeside.export.evidence-source/v1\",\"sources\":['\"$sources\"']}' \u003e '/workspace/.freeside-evidence/.control/evidence.json'; chmod 0644 '/workspace/.freeside-evidence/.control/evidence.json'; rm -rf -- '/workspace/.freeside-evidence/evidence.json'; mv -T '/workspace/.freeside-evidence/.control/evidence.json' '/workspace/.freeside-evidence/evidence.json'; if [ -f '/var/lib/freeside-launch/agent-transcript.jsonl' ]; then if [ \"$status\" -ne 0 ] \u0026\u0026 [ -s '/var/lib/freeside-launch/agent-stderr.log' ]; then cat '/var/lib/freeside-launch/agent-stderr.log' \u003e\u003e '/var/lib/freeside-launch/agent-transcript.jsonl'; fi; cp '/var/lib/freeside-launch/agent-transcript.jsonl' '/workspace/.freeside-evidence/.control/agent-transcript.jsonl'; chmod 0644 '/workspace/.freeside-evidence/.control/agent-transcript.jsonl'; rm -rf -- '/workspace/.freeside-evidence/agent-transcript.jsonl'; mv -T '/workspace/.freeside-evidence/.control/agent-transcript.jsonl' '/workspace/.freeside-evidence/agent-transcript.jsonl'; fi; rm -rf -- '/workspace/node_modules'; printf '%s %s\\n' '{{FREESIDE_WRITER_NONCE}}' \"$status\" \u003e '/workspace/.freeside-evidence/.control/writer-outcome'; sync; exit \"$status\""
]
