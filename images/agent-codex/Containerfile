# Freeside agent base for the Codex CLI (plan §5.4, §5.7; issue #404).
#
# The digest-pinned image the Codex agent stage runs in under the
# `subscription_contained` credential mode: the native vendor CLI runs in the
# agent VM, its credential mount read-only. Plan §5.7 requires golden images to
# pin CLI versions, so the Codex CLI version is an explicit build input,
# recorded in a label and in the in-image manifest, and asserted from the built
# image by scripts/build-agent-codex-image.sh.
#
# Instructions this image must NOT carry (ward check 2,
# daemon/internal/ward/conformance.go verifyAgentAllowlist):
#
#   ENV        - Apple container 1.1.0 merges image environment into the
#                created container's initProcess.environment (measured), and
#                the gate compares that list against exactly the fixed PATH
#                plus the daemon-supplied Env. Any image variable fails it.
#   WORKDIR    - honored by the runtime (measured); the gate requires "/".
#   ENTRYPOINT
#   CMD        - the command is daemon-owned and inspect-verified before the
#                container starts, exactly as in images/exporter/Containerfile.
#   USER       - ward passes no user; the workspace volume is root-owned.
#   VOLUME     - would add an anonymous mount to a topology the gate compares
#                mount-for-mount.
#
# LABEL is not inspected by the gate and is the safe place for provenance.
#
# The image is linux/arm64 only: Apple container on Apple silicon is the
# Phase 1A runtime.

# The pins are declared before the first FROM so both stages, and the labels in
# the final one, see the same values. The Codex CLI is a static musl binary, so
# unlike the Claude base this image needs no language runtime; it is taken from
# the upstream release package and verified against the sha256 literal held
# here. The package, not the bare binary, is upstream's standalone layout: it
# carries `codex-resources` and `bin/codex-code-mode-host` alongside
# `bin/codex`. The final image preserves the existing
# `/usr/local/bin/codex-resources` shape, the CLI's first legacy candidate
# relative to `/usr/local/bin/codex`, so its bundled bwrap and zsh remain
# available without adding the package's separate `codex-path` to PATH. The
# code-mode host ships beside the CLI because 0.147.0's default tool surface
# routes composite shell commands through it: without the executable those
# exec calls fail closed on every attempt, and the model can then report
# success it never had (probed 2026-08-09; see
# devlog/2026-08-09-1925-codex-0147-contract-reproof.md).
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd
ARG CODEX_VERSION=0.147.0
ARG CODEX_PACKAGE_SHA256=692ff5c5d9eb86774c0448d930895e46659eee6a2c12f46b97399da458c1e8b7

FROM ${BASE_IMAGE} AS build

ARG CODEX_VERSION
ARG CODEX_PACKAGE_SHA256

# curl and zstd are build-only. The final image's BusyBox applets are runtime
# witnesses for ward's egress conformance, not build inputs.
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends ca-certificates curl zstd; \
	rm -rf /var/lib/apt/lists/*

RUN set -eux; \
	curl -fsSLo /tmp/codex-package.tar.zst \
		"https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-package-aarch64-unknown-linux-musl.tar.zst"; \
	echo "${CODEX_PACKAGE_SHA256}  /tmp/codex-package.tar.zst" | sha256sum -c -; \
	mkdir -p /out; \
	tar --zstd -xf /tmp/codex-package.tar.zst -C /out; \
	rm /tmp/codex-package.tar.zst; \
	chmod 0755 /out/bin/codex /out/bin/codex-code-mode-host /out/codex-resources/bwrap; \
	/out/bin/codex --version

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG CODEX_VERSION

# git is a workspace tool: the agent commits normally, and nothing of its .git
# is ever imported as git state (plan §5.6). ripgrep is a CLI runtime
# dependency, not a convenience: the Codex file-search tool shells out to
# `rg --files --no-ignore --null …`, and the CLI reports a missing one as a
# broken installation. ca-certificates serves the provider API under the
# `provider_only` egress profile. BusyBox supplies the nslookup, nc, and wget
# applets whose exact behavior ward uses to witness that provider-only egress
# is realized. Package versions are recorded in the manifest below rather than
# pinned: Debian drops superseded versions from the mirror, so an exact pin
# turns into an unbuildable image.
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends busybox-static ca-certificates git ripgrep; \
	rm -rf /var/lib/apt/lists/*; \
	for applet in nc nslookup wget; do \
		ln -s /bin/busybox "/usr/local/bin/${applet}"; \
	done; \
	nslookup --help 2>&1 | grep -F 'HOST [DNS_SERVER]'; \
	nc -h 2>&1 | grep -F -- '-w SEC'; \
	wget --help >/dev/null

COPY --from=build /out/bin/codex /usr/local/bin/codex
COPY --from=build /out/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host
COPY --from=build /out/codex-resources /usr/local/bin/codex-resources

# The manifest records what the pinned inputs actually resolved to. Running the
# CLI here also proves it starts in this image; unlike the Claude base there is
# no state to clean up afterwards, because `codex --version` writes nothing
# outside CODEX_HOME and the daemon supplies that per invocation.
RUN set -eux; \
	mkdir -p /usr/local/share/freeside; \
	{ \
		echo "base_image ${BASE_IMAGE}"; \
		echo "codex $(codex --version)"; \
		echo "codex-code-mode-host sha256:$(sha256sum /usr/local/bin/codex-code-mode-host | cut -d' ' -f1)"; \
		echo "rg $(rg --version | head -n 1)"; \
		echo "bwrap $(/usr/local/bin/codex-resources/bwrap --version)"; \
		echo "zsh $(/usr/local/bin/codex-resources/zsh/bin/zsh --version)"; \
		echo "--- dpkg ---"; \
		dpkg-query -W -f='${binary:Package} ${Version}\n'; \
	} > /usr/local/share/freeside/image-manifest.txt

LABEL org.opencontainers.image.title="freeside-agent-codex" \
	org.opencontainers.image.description="Freeside agent base: pinned Codex CLI on a pinned Debian slim base" \
	org.opencontainers.image.base.name="${BASE_IMAGE}" \
	ai.freeside.codex-cli.version="${CODEX_VERSION}"
