          "-installation-id", "<prod App installation id on the fixture>",
          "-image-name", "freeside-project-review-challenge"
        ]
      }
    },
    "second_writer": {
      "auth_identity": "<second writer identity>",
      "auth_volume": "<second writer credential volume>",
