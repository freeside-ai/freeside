    },
    "agent_tree": {
      "checkout": "/Users/<you>/.freeside/agent-tree",
      "auth_identity": "<writer identity>",
      "review_auth_identity": "<review identity>",
      "cost_owner": "<writer cost owner>",
      "review_cost_owner": "<review cost owner>",
      "claude_account": "<writer's attested account>",
      "terms_basis_date": "<YYYY-MM-DD the tree was adopted with>",
