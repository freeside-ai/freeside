      "-base-image", "<digest-pinned agent base image>",
      "-base-build-ref", "<local tag matching -base-image>",
      "-local-registry-port", "<managed loopback registry port>",
      "-dns", "<build DNS server>"
    ],
    "commit_author": {"app_slug": "<prod App slug>", "bot_user_id": 0},
    "repositories": {
